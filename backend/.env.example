# Copy this to .env and fill in real keys.
# If keys are missing, the app automatically runs in MOCK_MODE with canned results for the 3 sample docs.

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
DATABASE_URL=sqlite:///./verifai.db
CORS_ORIGINS=*
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_CONCURRENCY=1
