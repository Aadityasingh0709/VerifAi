# Leave LLM keys blank to run the three built-in sample documents in mock mode.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=

# Optional web-search providers for live verification.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Set to 1 to force canned sample results even when an LLM key is present.
MOCK_MODE=
MOCK_SEARCH=

# Local development defaults.
CORS_ORIGINS=*
DATABASE_URL=sqlite:///./verifai.db
MAX_CLAIMS_PER_DOC=12
MAX_DOC_CHARS=15000
SEARCH_RESULTS_PER_QUERY=5
SEARCH_CONCURRENCY=4
